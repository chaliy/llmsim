{
 "name": "tool-trouble",
 "description": "Tools that fail: a command that exits non-zero, a command that outlives its timeout, a read of a missing file, each retried by the model, then an answer. Needs the bash tool.",
 "defaults": {
  "timing": {
   "ttft_ms": [
    800,
    1300
   ],
   "tokens_per_sec": 65
  }
 },
 "steps": [
  {
   "turn": {
    "type": "mixed",
    "text": "Running the build.",
    "calls": [
     {
      "name": "bash",
      "arguments": {
       "commands": "echo 'error: linker failed' >&2; exit 1",
       "timeout_ms": 30000
      }
     }
    ]
   }
  },
  {
   "turn": {
    "type": "mixed",
    "text": "The build failed; retrying with a clean tree.",
    "calls": [
     {
      "name": "bash",
      "arguments": {
       "commands": "echo build ok",
       "timeout_ms": 30000
      }
     }
    ]
   }
  },
  {
   "turn": {
    "type": "mixed",
    "text": "Running the slow integration suite.",
    "calls": [
     {
      "name": "bash",
      "arguments": {
       "commands": "sleep 30; echo done",
       "timeout_ms": 5000
      }
     }
    ]
   }
  },
  {
   "turn": {
    "type": "mixed",
    "text": "It timed out; running the fast subset instead.",
    "calls": [
     {
      "name": "bash",
      "arguments": {
       "commands": "sleep 2; echo 12 passed",
       "timeout_ms": 30000
      }
     }
    ]
   }
  },
  {
   "turn": {
    "type": "tool_calls",
    "calls": [
     {
      "name": "bash",
      "arguments": {
       "commands": "cat /no/such/file",
       "timeout_ms": 30000
      }
     }
    ]
   }
  },
  {
   "turn": {
    "type": "assistant",
    "lorem_tokens": [
     120,
     260
    ]
   }
  }
 ]
}
