__version__: str

class LlmSimError(RuntimeError): ...

class NativeServer:
    @property
    def url(self) -> str: ...
    @property
    def host(self) -> str: ...
    @property
    def port(self) -> int: ...
    @property
    def is_running(self) -> bool: ...
    def stats_json(self) -> str: ...
    def stop(self) -> None: ...

def start(toml: str | None = None, overrides_json: str | None = None) -> NativeServer: ...
def resolve_config(toml: str | None = None, overrides_json: str | None = None) -> str: ...
