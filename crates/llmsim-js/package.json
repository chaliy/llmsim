{
  "name": "llmsim",
  "version": "0.7.0",
  "description": "In-process LLM API simulator (OpenAI, Anthropic, OpenResponses) for tests and load testing",
  "type": "module",
  "main": "wrapper.js",
  "types": "wrapper.d.ts",
  "exports": {
    ".": {
      "types": "./wrapper.d.ts",
      "default": "./wrapper.js"
    }
  },
  "author": "Mykhailo Chalyi <mike@chaliy.name>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaliy/llmsim.git",
    "directory": "crates/llmsim-js"
  },
  "homepage": "https://github.com/chaliy/llmsim",
  "bugs": "https://github.com/chaliy/llmsim/issues",
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "simulator",
    "mock",
    "testing"
  ],
  "napi": {
    "binaryName": "llmsim",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "files": [
    "wrapper.js",
    "wrapper.d.ts",
    "index.cjs",
    "index.d.cts",
    "llmsim.*.node"
  ],
  "scripts": {
    "build": "npm run build:napi && npm run build:ts",
    "build:napi": "napi build --platform --release --js index.cjs --dts index.d.cts",
    "build:debug": "napi build --platform --js index.cjs --dts index.d.cts && npm run build:ts",
    "build:ts": "tsc",
    "test": "node --test __test__/*.test.mjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@napi-rs/cli": "^3.9.0",
    "@types/node": "^22.0.0",
    "openai": "^6.45.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">= 18"
  }
}
